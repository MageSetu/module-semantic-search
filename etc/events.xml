<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Event/etc/events.xsd">
        
    <event name="catalog_product_save_after">
        <observer
            name="magesetu_semanticsearch_product_index_row"
            instance="MageSetu\SemanticSearch\Observer\ProductSaveAfter" />
    </event>

    <event name="catalog_product_delete_after_done">
        <observer name="magesetu_semanticsearch_delete_embedding"
            instance="MageSetu\SemanticSearch\Observer\ProductDeleteAfter"/>
    </event>
</config>