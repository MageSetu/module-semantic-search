<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Mview/etc/mview.xsd">
    <view id="magesetu_semanticsearch_product"
        class="MageSetu\SemanticSearch\Model\Indexer\SemanticSearch\Indexer"
        group="indexer">
        <subscriptions>
        
            <!-- Core product row — catches creates, deletes, attribute set changes -->
            <table name="catalog_product_entity" entity_column="entity_id"/>

            <!-- Varchar attributes: name, url_key, meta_title, meta_description -->
            <table name="catalog_product_entity_varchar" entity_column="entity_id"/>

            <!-- Text attributes: description, short_description -->
            <table name="catalog_product_entity_text" entity_column="entity_id"/>

        </subscriptions>
    </view>
</config>