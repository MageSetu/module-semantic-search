<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Indexer/etc/indexer.xsd">
    <indexer id="magesetu_semanticsearch_product"
            view_id="magesetu_semanticsearch_product"
            class="MageSetu\SemanticSearch\Model\Indexer\SemanticSearch\Indexer"
            primary="catalog_product">
        <title translate="true">Semantic Search Product Embeddings</title>
        <description translate="true">
            Indexes product data into vector embeddings for semantic search.
        </description>
        <!--
            Dependencies ensure our indexer runs AFTER core data is committed.
        -->
        <dependencies>
            <indexer id="catalog_product_attribute"/>
            <indexer id="catalog_product_price"/>
        </dependencies>
    </indexer>
</config>