<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Config:etc/system_file.xsd">
    <system>
        <!-- Semantic Search Section -->
        <section id="magesetu_semantic_search" translate="label" type="text" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
            <label>Semantic Search</label>
            <tab>magesetu_common</tab>
            <resource>MageSetu_SemanticSearch::config</resource>

            <!-- General Group  -->
            <group id="general" translate="label" type="text" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>General Settings</label>
                
                <field id="enabled" translate="label" type="select" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1" canRestore="1">
                    <label>Enable Module</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>

                <field id="semantic_attributes" translate="label" type="multiselect" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1" canRestore="1">
                    <label>Attributes Used For Semantic Embedding</label>
                    <source_model>MageSetu\SemanticSearch\Model\Config\Source\AiSearchContextAttributeProvider</source_model>
                    <backend_model>MageSetu\SemanticSearch\Model\Config\Backend\SemanticAttributes</backend_model>
                    <depends>
                        <field id="enabled">1</field>
                    </depends>
                    <comment><![CDATA[
                        <span style="color:#d32f2f; font-weight:bold;">WARNING!</span>
                        <span>Saving changes to this configuration will need reindexing semantic search data for all products.</span>
                        <span>Reindexing operation may increase server load and <strong>consume billable API requests</strong>.</span>
                        <span>Please confirm this change is necessary before proceeding.</span>
                        <span>After the change, run <br>'php bin/magento indexer:reindex magesetu_semanticsearch_product'<br> to regenerate the embeddings.</span>
                    ]]></comment>
                </field>

                <field id="index_batch_size" translate="label" type="text" sortOrder="20" showInDefault="1" showInWebsite="1" showInStore="1" canRestore="1">
                    <label>Indexer Batch Size</label>
                    <comment>Batch size to generate index in batches.</comment>
                    <validate>required-entry validate-digits validate-greater-than-zero</validate>
                    <depends>
                        <field id="enabled">1</field>
                    </depends>
                </field>

                <field id="embedding_batch_size" translate="label" type="text" sortOrder="20" showInDefault="1" showInWebsite="1" showInStore="1" canRestore="1">
                    <label>Batch Size</label>
                    <comment>Batch size to generate embeddings [per API call].</comment>
                    <validate>required-entry validate-digits validate-greater-than-zero</validate>
                    <depends>
                        <field id="enabled">1</field>
                    </depends>
                </field>
            </group>

            <!-- Embedding LLM Configurations -->
            <group id="embedding_llm" translate="label" type="text" sortOrder="20" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>Embedding LLM Settings</label>
                <depends>
                    <field id="magesetu_semantic_search/general/enabled">1</field>
                </depends>

                <!-- Select LLM Provider -->
                <field id="provider" translate="label comment" type="select" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Embedding Provider</label>
                    <source_model>MageSetu\SemanticSearch\Model\Config\Source\EmbeddingProvider</source_model>
                    <validate>required-entry</validate>
                    <comment><![CDATA[
                        <span style="color:#d32f2f; font-weight:bold;">WARNING!</span>
                        <span>Saving changes to this configuration will remove all the embeddings form the vector storage.</span>
                        <span>It will need reindexing semantic search data for all products.</span>
                        <span>Reindexing operation may increase server load and <strong>consume billable API requests</strong>.</span>
                        <span>Please confirm this change is necessary before proceeding.</span>
                        <span>After the change, run <br>'php bin/magento indexer:reindex magesetu_semanticsearch_product'<br> to regenerate the embeddings.</span>
                    ]]></comment>
                </field>

                <!-- OpenAI embeddings -->
                <field id="openai_model" translate="label" type="select" sortOrder="20" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>OpenAI Embedding Model</label>
                    <source_model>MageSetu\AiBase\Model\Config\Source\OpenAiEmbeddingModel</source_model>
                    <backend_model>MageSetu\SemanticSearch\Model\Config\Backend\ConditionalValue</backend_model>
                    <depends>
                        <field id="provider">openai</field>
                    </depends>
                    <comment><![CDATA[
                        <span style="color:#d32f2f; font-weight:bold;">WARNING!</span>
                        <span>Saving changes to this configuration will remove all the embeddings form the vector storage.</span>
                        <span>It will need reindexing semantic search data for all products.</span>
                        <span>Reindexing operation may increase server load and <strong>consume billable API requests</strong>.</span>
                        <span>Please confirm this change is necessary before proceeding.</span>
                        <span>After the change, run <br>'php bin/magento indexer:reindex magesetu_semanticsearch_product'<br> to regenerate the embeddings.</span>
                    ]]></comment>
                </field>
                <field id="openai_api_key" translate="label comment" type="obscure" sortOrder="32" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>API Key Form OpenAI Embedding Model</label>
                    <comment>Your secret key from platform.openai.com.</comment>
                    <backend_model>MageSetu\SemanticSearch\Model\Config\Backend\ConditionalEncrypted</backend_model>
                    <depends>
                        <field id="provider">openai</field>
                    </depends>
                </field>
                <field id="openai_base_url" translate="label comment" type="text" sortOrder="35" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Base URL For OpenAI Embedding Model</label>
                    <comment>Override only if using a custom proxy or Azure endpoint. Leave blank for the default 'https://api.openai.com'.</comment>
                    <validate>validate-url</validate>
                    <depends>
                        <field id="provider">openai</field>
                    </depends>
                </field>

                <!-- Ollama embeddings -->
                <field id="ollama_model" translate="label" type="select" sortOrder="25" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Ollama Embedding Model</label>
                    <source_model>MageSetu\AiBase\Model\Config\Source\OllamaEmbeddingModel</source_model>
                    <backend_model>MageSetu\SemanticSearch\Model\Config\Backend\ConditionalValue</backend_model>
                    <depends>
                        <field id="provider">ollama</field>
                    </depends>
                    <comment><![CDATA[
                        <span style="color:#d32f2f; font-weight:bold;">WARNING!</span>
                        <span>Saving changes to this configuration will remove all the embeddings form the vector storage.</span>
                        <span>It will need reindexing semantic search data for all products.</span>
                        <span>Reindexing operation may increase server load and <strong>consume billable API requests</strong>.</span>
                        <span>Please confirm this change is necessary before proceeding.</span>
                        <span>After the change, run <br>'php bin/magento indexer:reindex magesetu_semanticsearch_product'<br> to regenerate the embeddings.</span>
                    ]]></comment>
                </field>
                <field id="ollama_api_key" translate="label comment" type="obscure" sortOrder="32" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>API Key For Ollama Embedding Model</label>
                    <comment>Your secret key from Ollama [Optional].</comment>
                    <backend_model>Magento\Config\Model\Config\Backend\Encrypted</backend_model>
                    <depends>
                        <field id="provider">ollama</field>
                    </depends>
                </field>
                <field id="ollama_base_url" translate="label comment" type="text" sortOrder="45" showInDefault="1" showInWebsite="1" showInStore="1" canRestore="1">
                    <label>Host URL For Ollama Embedding Model</label>
                    <comment>Base URL of your Ollama instance, e.g. http://localhost:11434</comment>
                    <validate>required-entry validate-url</validate>
                    <depends>
                        <field id="provider">ollama</field>
                    </depends>
                </field>

                <!-- Test connection -->
                <field id="test_embedding_connection" translate="label" type="button" sortOrder="85" showInDefault="1" showInWebsite="1" showInStore="1" canRestore="0">
                    <label>Test Connection</label>
                    <button_label>Test Connection</button_label>
                    <frontend_model>MageSetu\SemanticSearch\Block\Adminhtml\System\Config\Embedding\TestConnection</frontend_model>
                    <depends>
                        <field id="provider" negative="1"></field>
                    </depends>
                </field>

                <field id="cache_lifetime" translate="label comment" type="text" sortOrder="85" showInDefault="1" showInWebsite="1" showInStore="1" canRestore="1">
                    <label>Embedding Cache Lifetime</label>
                    <comment>Cache lifetime in seconds.</comment>
                    <validate>validate-number validate-zero-or-greater</validate>
                    <depends>
                        <field id="enabled">1</field>
                    </depends>
                </field>
            </group>

            <!-- Embedding Guardrails Configurations -->
            <group id="guardrails" translate="label" type="text" sortOrder="30" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>Query Guardrails Settings</label>
                <depends>
                    <field id="magesetu_semantic_search/general/enabled">1</field>
                </depends>

                <field id="enabled" translate="label" type="select" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1" canRestore="1">
                    <label>Enable Query AI Guardrails</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <comment>validates user query before doing the vector search.</comment>
                    <depends>
                        <field id="magesetu_semantic_search/general/enabled">1</field>
                    </depends>
                </field>

                <!-- Select LLM Provider -->
                <field id="provider" translate="label comment" type="select" sortOrder="20" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Guardrails Provider</label>
                    <comment>Select the AI provider that will review the user query.</comment>
                    <source_model>MageSetu\SemanticSearch\Model\Config\Source\GuardrailsProvider</source_model>
                    <validate>required-entry</validate>
                    <depends>
                        <field id="enabled">1</field>
                    </depends>
                </field>

                <!-- OpenAi Settings -->
                <field id="openai_model" translate="label comment" type="select" sortOrder="30" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>OpenAI Model</label>
                    <comment>Choose the OpenAI model to use for guardrails.</comment>
                    <source_model>MageSetu\AiBase\Model\Config\Source\OpenAiChatModel</source_model>
                    <backend_model>MageSetu\SemanticSearch\Model\Config\Backend\ConditionalValue</backend_model>
                    <depends>
                        <field id="enabled">1</field>
                        <field id="provider">openai</field>
                    </depends>
                </field>
                <field id="openai_api_key" translate="label comment" type="obscure" sortOrder="32" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>API Key For OpenAI Guardrails Model</label>
                    <comment>Your secret key from platform.openai.com.</comment>
                    <backend_model>MageSetu\SemanticSearch\Model\Config\Backend\ConditionalEncrypted</backend_model>
                    <depends>
                        <field id="enabled">1</field>
                        <field id="provider">openai</field>
                    </depends>
                </field>
                <field id="openai_base_url" translate="label comment" type="text" sortOrder="35" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Base URL For OpenAI Guardrails Model</label>
                    <comment>Override only if using a custom proxy or Azure endpoint. Leave blank for the default.</comment>
                    <validate>validate-url</validate>
                    <depends>
                        <field id="enabled">1</field>
                        <field id="provider">openai</field>
                    </depends>
                </field>

                <!-- Ollama setting -->
                <field id="ollama_model" translate="label comment" type="select" sortOrder="40" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Ollama Guardrails Model</label>
                    <comment>Choose a locally-served Ollama model for guardrails.</comment>
                    <source_model>MageSetu\AiBase\Model\Config\Source\OllamaChatModel</source_model>
                    <backend_model>MageSetu\SemanticSearch\Model\Config\Backend\ConditionalValue</backend_model>
                    <depends>
                        <field id="enabled">1</field>
                        <field id="provider">ollama</field>
                    </depends>
                </field>
                <field id="ollama_api_key" translate="label comment" type="obscure" sortOrder="42" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>API Key For Ollama Guardrails Model</label>
                    <comment>Your secret key from Ollama [Optional].</comment>
                    <backend_model>Magento\Config\Model\Config\Backend\Encrypted</backend_model>
                    <depends>
                        <field id="enabled">1</field>
                        <field id="provider">ollama</field>
                    </depends>
                </field>
                <field id="ollama_base_url" translate="label comment" type="text" sortOrder="45" showInDefault="1" showInWebsite="1" showInStore="1" canRestore="1">
                    <label>Host URL For Ollama Guardrails Model</label>
                    <comment>Base URL of your Ollama instance, e.g. http://localhost:11434</comment>
                    <validate>required-entry validate-url</validate>
                    <depends>
                        <field id="enabled">1</field>
                        <field id="provider">ollama</field>
                    </depends>
                </field>

                <!-- Test connection -->
                <field id="test_connection" translate="label" type="button" sortOrder="70" showInDefault="1" showInWebsite="1" showInStore="1" canRestore="0">
                    <label>Test Connection</label>
                    <button_label>Test Connection</button_label>
                    <frontend_model>MageSetu\SemanticSearch\Block\Adminhtml\System\Config\Guardrails\TestConnection</frontend_model>
                    <depends>
                        <field id="enabled">1</field>
                        <field id="provider" negative="1"></field>
                    </depends>
                </field>

                <field id="guard_system_prompt" translate="label" type="textarea" sortOrder="82" showInDefault="1" showInWebsite="1" showInStore="1" canRestore="1">
                    <label>Guardrails System Prompt</label>
                    <comment><![CDATA[
                        <span>Note: user query will be passed in <strong>&lt;user_input&gt;&lt;/user_input&gt;</strong> tag. You can build your guardrail using it for proper result.</span>
                    ]]></comment>
                    <validate>required-entry</validate>
                    <depends>
                        <field id="enabled">1</field>
                    </depends>
                </field>
                <field id="reasoning_effort" translate="label comment" type="select" sortOrder="84" showInDefault="1" showInWebsite="1" showInStore="1" canRestore="1">
                    <label>Reasoning Effort [Thinking]</label>
                    <source_model>MageSetu\AiBase\Model\Config\Source\ReasoningEffort</source_model>
                    <comment><![CDATA[
                        <p>Controls the reasoning effort used by supported LLMs.</p>
                        <p>
                            <strong>Note:</strong> This setting only applies to models that support reasoning or thinking capabilities.
                            Models that do not support reasoning will ignore this option and have it's default supported value.
                        </p>
                    ]]></comment>
                    <depends>
                        <field id="enabled">1</field>
                    </depends>
                </field>
                <field id="max_tokens" translate="label" type="text" sortOrder="90" showInDefault="1" showInWebsite="1" showInStore="1" canRestore="1">
                    <label>Max Tokens</label>
                    <comment><![CDATA[
                        <span>Some models (like using qwen3.5:4b with ollama) needs thinking enabled and consumes more token to serve the request.</span>
                        <span>You can cap the token limit to abort API call.</span>
                    ]]></comment>
                    <validate>validate-number validate-zero-or-greater</validate>
                    <depends>
                        <field id="enabled">1</field>
                    </depends>
                </field>
                <field id="guard_error_msg" translate="label" type="textarea" sortOrder="86" showInDefault="1" showInWebsite="1" showInStore="1" canRestore="1">
                    <label>Guardrails Error Message</label>
                    <comment>Message to display when validation fails</comment>
                    <validate>required-entry</validate>
                    <depends>
                        <field id="enabled">1</field>
                    </depends>
                </field>
                <field id="cache_lifetime" translate="label comment" type="text" sortOrder="90" showInDefault="1" showInWebsite="1" showInStore="1" canRestore="1">
                    <label>Guardrails Cache Lifetime</label>
                    <comment>Cache lifetime in seconds.</comment>
                    <validate>validate-number validate-zero-or-greater</validate>
                    <depends>
                        <field id="enabled">1</field>
                    </depends>
                </field>
            </group>

            <!-- Vector Database Configurations -->
            <group id="vectordb" translate="label" type="text" sortOrder="50" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>Vector Database Settings</label>
                <depends>
                    <field id="magesetu_semantic_search/general/enabled">1</field>
                </depends>

                <!-- Select Vector Storage -->
                <field id="storage" translate="label comment" type="select" sortOrder="10" showInDefault="1" showInWebsite="0" showInStore="0">
                    <label>Vector Storage Provider</label>
                    <comment><![CDATA[
                        <span style="color:#d32f2f; font-weight:bold;">WARNING!</span>
                        <span>Saving changes to this configuration will need reindexing semantic search data for all products.</span>
                        <span>Reindexing operation may increase server load and <strong>consume billable API requests</strong>.</span>
                        <span>Please confirm this change is necessary before proceeding.</span>
                        <span>After the change, run <br>'php bin/magento indexer:reindex magesetu_semanticsearch_product'<br> to regenerate the embeddings.</span>
                    ]]></comment>
                    <source_model>MageSetu\SemanticSearch\Model\Config\Source\VectorStorage</source_model>
                    <validate>required-entry</validate>
                </field>

                <!-- OpenSearch settings -->
                <field id="opensearch_server_url" translate="label" type="text" sortOrder="31" showInDefault="1" showInWebsite="0" showInStore="0">
                    <label>OpenSearch Server</label>
                    <comment>Provide full URL including protocol and port</comment>
                    <backend_model>MageSetu\SemanticSearch\Model\Config\Backend\ConditionalValue</backend_model>
                    <depends>
                        <field id="storage">opensearch</field>
                    </depends>
                </field>
                <field id="opensearch_enable_auth" translate="label" type="select" sortOrder="33" showInDefault="1" showInWebsite="0" showInStore="0">
                    <label>Enable OpenSearch HTTP Auth</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <depends>
                        <field id="storage">opensearch</field>
                    </depends>
                </field>
                <field id="opensearch_username" translate="label" type="text" sortOrder="34" showInDefault="1" showInWebsite="0" showInStore="0">
                    <label>OpenSearch HTTP Username</label>
                    <depends>
                        <field id="storage">opensearch</field>
                        <field id="opensearch_enable_auth">1</field>
                    </depends>
                </field>
                <field id="opensearch_password" translate="label" type="obscure" sortOrder="35" showInDefault="1" showInWebsite="0" showInStore="0">
                    <label>OpenSearch HTTP Password</label>
                    <backend_model>Magento\Config\Model\Config\Backend\Encrypted</backend_model>
                    <depends>
                        <field id="storage">opensearch</field>
                        <field id="opensearch_enable_auth">1</field>
                    </depends>
                </field>
                <field id="opensearch_server_timeout" translate="label" type="text" sortOrder="36" showInDefault="1" showInWebsite="0" showInStore="0"  canRestore="1">
                    <label>OpenSearch Server Timeout</label>
                    <depends>
                        <field id="storage">opensearch</field>
                    </depends>
                </field>
                <field id="test_opensearch_connection" translate="label" type="button" sortOrder="70" showInDefault="1" showInWebsite="0" showInStore="0" canRestore="0">
                    <label>Test OpenSearch Connection</label>
                    <button_label>Test Connection</button_label>
                    <frontend_model>MageSetu\SemanticSearch\Block\Adminhtml\System\Config\VectorStorage\TestOpenSearchConnection</frontend_model>
                    <depends>
                        <field id="provider" negative="1"></field>
                        <field id="storage">opensearch</field>
                    </depends>
                </field>

                <!-- Qdrant settings -->
                <field id="qdrant_api_url" translate="label" type="text" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Qdrant API URL</label>
                    <backend_model>MageSetu\SemanticSearch\Model\Config\Backend\ConditionalValue</backend_model>
                    <depends>
                        <field id="storage">qdrant</field>
                    </depends>
                </field>
                <field id="qdrant_api_token" translate="label" type="obscure" sortOrder="15" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Qdrant API Token</label>
                    <backend_model>MageSetu\SemanticSearch\Model\Config\Backend\ConditionalEncrypted</backend_model>
                    <depends>
                        <field id="storage">qdrant</field>
                    </depends>
                </field>
                <field id="test_qdrant_connection" translate="label" type="button" sortOrder="70" showInDefault="1" showInWebsite="0" showInStore="0" canRestore="0">
                    <label>Test Qdrant Connection</label>
                    <button_label>Test Connection</button_label>
                    <frontend_model>MageSetu\SemanticSearch\Block\Adminhtml\System\Config\VectorStorage\TestQdrantConnection</frontend_model>
                    <depends>
                        <field id="provider" negative="1"></field>
                        <field id="storage">qdrant</field>
                    </depends>
                </field>

                <!-- Vector storage common settings -->
                <field id="search_limit" translate="label" type="text" sortOrder="75" showInDefault="1" showInWebsite="1" showInStore="1" canRestore="1">
                    <label>Search Limit</label>
                    <comment>Maximum number of semantically similar products to retrieve.</comment>
                    <validate>required-entry validate-digits validate-greater-than-zero</validate>
                </field>
                <field id="score_threshold" translate="label" type="text" sortOrder="80" showInDefault="1" showInWebsite="1" showInStore="1" canRestore="1">
                    <label>Score Threshold</label>
                    <comment>Minimum cosine-similarity score (0.0 - 1.0) for a result to be included.</comment>
                    <validate>required-entry validate-number validate-zero-or-greater</validate>
                </field>

            </group>

            <!-- Personalized Message Configurations -->
            <group id="personalized_message" translate="label" type="text" sortOrder="60" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>Personalized Message Settings</label>
                <depends>
                    <field id="magesetu_semantic_search/general/enabled">1</field>
                </depends>

                <field id="enabled" translate="label" type="select" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1" canRestore="1">
                    <label>Enable Personalized Message</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <comment>This feature adds a personalized message in the product search result.</comment>
                    <depends>
                        <field id="magesetu_semantic_search/general/enabled">1</field>
                    </depends>
                </field>

                <!-- Select LLM Provider -->
                <field id="provider" translate="label comment" type="select" sortOrder="20" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Personalized Message Provider</label>
                    <comment>Select the AI provider that will generate the personalized message.</comment>
                    <source_model>MageSetu\SemanticSearch\Model\Config\Source\PersonalizedMessageProvider</source_model>
                    <backend_model>MageSetu\SemanticSearch\Model\Config\Backend\PersonalizedMessageProvider</backend_model>
                    <depends>
                        <field id="enabled">1</field>
                    </depends>
                </field>

                <!-- OpenAi Settings -->
                <field id="openai_model" translate="label comment" type="select" sortOrder="30" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>OpenAI Model</label>
                    <comment>Choose the OpenAI model to use for personalized message.</comment>
                    <source_model>MageSetu\AiBase\Model\Config\Source\OpenAiChatModel</source_model>
                    <backend_model>MageSetu\SemanticSearch\Model\Config\Backend\ConditionalValue</backend_model>
                    <depends>
                        <field id="enabled">1</field>
                        <field id="provider">openai</field>
                    </depends>
                </field>
                <field id="openai_api_key" translate="label comment" type="obscure" sortOrder="32" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>API Key For OpenAI Model</label>
                    <comment>Your secret key from platform.openai.com.</comment>
                    <backend_model>MageSetu\SemanticSearch\Model\Config\Backend\ConditionalEncrypted</backend_model>
                    <depends>
                        <field id="enabled">1</field>
                        <field id="provider">openai</field>
                    </depends>
                </field>
                <field id="openai_base_url" translate="label comment" type="text" sortOrder="35" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Base URL For OpenAI Model</label>
                    <comment>Override only if using a custom proxy or Azure endpoint. Leave blank for the default.</comment>
                    <validate>validate-url</validate>
                    <depends>
                        <field id="enabled">1</field>
                        <field id="provider">openai</field>
                    </depends>
                </field>

                <!-- Ollama setting -->
                <field id="ollama_model" translate="label comment" type="select" sortOrder="40" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Ollama Model</label>
                    <comment>Choose a locally-served Ollama model for personalized message.</comment>
                    <source_model>MageSetu\AiBase\Model\Config\Source\OllamaChatModel</source_model>
                    <backend_model>MageSetu\SemanticSearch\Model\Config\Backend\ConditionalValue</backend_model>
                    <depends>
                        <field id="enabled">1</field>
                        <field id="provider">ollama</field>
                    </depends>
                </field>
                <field id="ollama_api_key" translate="label comment" type="obscure" sortOrder="42" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>API Key For Ollama Model</label>
                    <comment>Your secret key from Ollama [Optional].</comment>
                    <backend_model>Magento\Config\Model\Config\Backend\Encrypted</backend_model>
                    <depends>
                        <field id="enabled">1</field>
                        <field id="provider">ollama</field>
                    </depends>
                </field>
                <field id="ollama_base_url" translate="label comment" type="text" sortOrder="45" showInDefault="1" showInWebsite="1" showInStore="1" canRestore="1">
                    <label>Host URL For Ollama Model</label>
                    <comment>Base URL of your Ollama instance, e.g. http://localhost:11434</comment>
                    <validate>required-entry validate-url</validate>
                    <depends>
                        <field id="enabled">1</field>
                        <field id="provider">ollama</field>
                    </depends>
                </field>

                <!-- Test connection -->
                <field id="test_connection" translate="label" type="button" sortOrder="70" showInDefault="1" showInWebsite="1" showInStore="1" canRestore="0">
                    <label>Test Connection</label>
                    <button_label>Test Connection</button_label>
                    <frontend_model>MageSetu\SemanticSearch\Block\Adminhtml\System\Config\PersonalizedMessage\TestConnection</frontend_model>
                    <depends>
                        <field id="enabled">1</field>
                        <field id="provider" negative="1"></field>
                    </depends>
                </field>

                <!-- Personalized model common settings -->
                <field id="system_context" translate="label" type="textarea" sortOrder="80" showInDefault="1" showInWebsite="1" showInStore="1" canRestore="1">
                    <label>Personalized Message System Context</label>
                    <comment><![CDATA[
                        <span>Note: user query will be passed in <strong>&lt;user_input&gt;&lt;/user_input&gt;</strong> tag and recommended products in <strong>&lt;recommended_products&gt;&lt;/recommended_products&gt;</strong> tag. You can build your system prompt using it for proper result.</span>
                    ]]></comment>
                    <validate>required-entry</validate>
                    <depends>
                        <field id="enabled">1</field>
                    </depends>
                </field>
                <field id="temperature" translate="label comment" type="text" sortOrder="85" showInDefault="1" showInWebsite="1" showInStore="1" canRestore="1">
                    <label>Temperature</label>
                    <comment>Temperature will be applied to the models which supports it. Sampling temperature (0.0 - 2.0). Lower = more deterministic.</comment>
                    <validate>validate-number validate-zero-or-greater</validate>
                    <depends>
                        <field id="enabled">1</field>
                    </depends>
                </field>
                <field id="max_tokens" translate="label" type="text" sortOrder="90" showInDefault="1" showInWebsite="1" showInStore="1" canRestore="1">
                    <label>Max Tokens</label>
                    <comment>Keep tokens as Minimum as possible to avoid response delay on the frontend.</comment>
                    <validate>validate-number validate-zero-or-greater</validate>
                    <depends>
                        <field id="enabled">1</field>
                    </depends>
                </field>

            </group>
        </section>
    </system>
</config>
